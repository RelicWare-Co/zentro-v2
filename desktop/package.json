{
  "name": "@zentro/desktop",
  "productName": "Zentro",
  "version": "0.1.0",
  "description": "Desktop wrapper for Zentro web app.",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:msix": "bun run msix:assets && electron-forge make --targets msix --arch x64",
    "make:win": "electron-forge make --platform win32 --arch x64",
    "check": "tsc --noEmit && ultracite check .",
    "fix": "ultracite fix .",
    "icons": "node scripts/generate-icons.mjs",
    "msix:assets": "node scripts/generate-msix-assets.mjs"
  },
  "keywords": [
    "zentro",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Verzach3",
    "email": "gabrielcorreacardenas@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-msix": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.9.0",
    "typescript": "^7.0.2",
    "ultracite": "7.8.3",
    "vite": "^8.0.16"
  },
  "dependencies": {}
}
